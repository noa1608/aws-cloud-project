{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowECRAuthorization",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowPushImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:084375543286:repository/orders-api",
        "arn:aws:ecr:us-east-1:084375543286:repository/inventory-service"
      ]
    }
  ]
}
